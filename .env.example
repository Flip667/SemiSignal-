# Microsoft Foundry credentials — copy this file to .env and fill it in.
# Get these values from the Foundry portal -> your resource -> "Keys and Endpoint".

# API key for your Foundry resource
ANTHROPIC_FOUNDRY_API_KEY=paste-your-key-here

# Your Foundry resource name (the identifier before .services.ai.azure.com)
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name

# Alternative: full base URL instead of resource name
# ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic/
